cc_binary {
    name: "lge-zramd",
    stem: "lge-zramd",
    vendor: true,
    srcs: ["src/main.c", "src/core.c", "src/lifecycle.c", "src/backend.c", "src/dm_backend.c",
        "src/demand_watch.c", "src/demand_exec.c",
        "src/memory_budget.c", "src/boot_state.c", "src/log.c",
        "src/swap.c", "src/vm.c", "src/metrics.c", "src/policy.c",
        "src/execution.c", "src/diagnostics.c",
        "src/request_backend.c", "src/spawn_fd.c",
        "src/event_daemon.c", "src/intent.c",
        "src/config.c", "src/io.c", "src/helper.c", "src/recovery.c"],
    cflags: ["-std=c11", "-Wall", "-Wextra", "-Werror", "-D_FILE_OFFSET_BITS=64",
        "-ffunction-sections", "-fdata-sections"],
    ldflags: ["-Wl,-z,now", "-Wl,--gc-sections"],
    shared_libs: ["liblog"],
    compile_multilib: "64",
}
